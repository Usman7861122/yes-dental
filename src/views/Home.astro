---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Services from "../components/sections/Services.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import Locations from "../components/sections/Locations.astro";
import Membership from "../components/sections/Membership.astro";
import Insurance from "../components/sections/Insurance.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Contact from "../components/sections/Contact.astro";
import { getLang } from "../i18n";
import { heroSources } from "../lib/images";
const lang = getLang(Astro);
const hero = await heroSources();
---

<BaseLayout
  title={lang === "es" ? "Yes Dental | Dentista en Manhattan, Nueva York" : "Yes Dental | Family & Cosmetic Dentist in Manhattan, NYC"}
  description={
    lang === "es"
      ? "Yes Dental, en 617 West 181st Street, Manhattan: implantes, coronas, ortodoncia, tratamientos de conducto y más. Llame al (212) 781-0700."
      : "Yes Dental, at 617 West 181st Street in Manhattan: implants, crowns, orthodontics, root canals and more. Call (212) 781-0700."
  }
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={hero.avif.srcset} imagesizes="100vw" fetchpriority="high" />
  <Hero />
  <About />
  <Services />
  <WhyChooseUs />
  <Locations />
  <Membership />
  <Insurance />
  <Testimonials />
  <Contact />
</BaseLayout>
