---
import BaseLayout from "../layouts/BaseLayout.astro";
import { forms } from "../data/forms";
import { site, contactHref } from "../data/site";
import { getLang, lp } from "../i18n";
import { useUi } from "../i18n/ui";
import PageHero from "../components/ui/PageHero.astro";
import Reveal from "../islands/Reveal";
import Button from "../components/ui/Button.astro";

const lang = getLang(Astro);
const t = useUi(lang);
const copy = {
  en: {
    title: "Patient Forms | Yes Dental",
    description: "Download the Yes Dental patient registration form in English or Spanish and fill it in before your visit.",
    eyebrow: "Patient Forms",
    h1: "Save time at your",
    accent: "first visit.",
    intro: "Download our registration form, fill it in at home, and bring it with you to your appointment.",
    helpA: "Need help with a form or want it in another format? Call us on",
    helpB: "and our team will be happy to help.",
    ctaA: "Ready to",
    ctaAccent: "book your visit?",
  },
  es: {
    title: "Formularios para pacientes | Yes Dental",
    description: "Descargue el formulario de registro de pacientes de Yes Dental en inglés o español y complételo antes de su visita.",
    eyebrow: "Formularios",
    h1: "Ahorre tiempo en su",
    accent: "primera visita.",
    intro: "Descargue nuestro formulario de registro, complételo en casa y tráigalo a su cita.",
    helpA: "¿Necesita ayuda con un formulario o lo quiere en otro formato? Llámenos al",
    helpB: "y nuestro equipo con gusto le ayudará.",
    ctaA: "¿Listo para",
    ctaAccent: "reservar su visita?",
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.h1}
    accent={copy.accent}
    intro={copy.intro}
  />

  <section class="section-y bg-sand">
    <div class="container-x">
      <ul class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {
          forms.map((f, i) => (
            <li>
              <Reveal client:visible delay={i * 0.08} className="h-full">
                <article class="flex h-full flex-col rounded-2xl bg-white p-8 shadow-[0_20px_50px_-35px_rgba(14,26,58,0.5)] sm:p-10" lang={f.lang}>
                  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink text-gold">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                  </span>
                  <p class="eyebrow mt-6 text-gold-deep">{f.language}</p>
                  <h2 class="mt-2 text-4xl text-ink">{f.title}</h2>
                  <p class="mt-4 flex-1 text-mute">{f.description}</p>
                  <p class="mt-6 text-sm text-mute">{f.format} · {f.size}</p>
                  <a
                    href={f.href}
                    download
                    class="btn btn-ink mt-6 w-full sm:w-auto sm:self-start"
                    aria-label={`${f.title}, ${f.format}, ${f.size}`}
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg>
                    {f.lang === "es" ? "Descargar formulario" : "Download Form"}
                  </a>
                </article>
              </Reveal>
            </li>
          ))
        }
      </ul>
      <p class="mx-auto mt-10 max-w-2xl text-center text-mute">
        {copy.helpA} <a href={`tel:${site.phone.tel}`} class="font-semibold text-gold-deep underline underline-offset-4">{site.phone.display}</a> {copy.helpB}
      </p>
    </div>
  </section>

  <section class="on-dark bg-ink py-20 text-ivory lg:py-24">
    <div class="container-x flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div>
        <h2 class="h-display max-w-2xl">{copy.ctaA} <em class="font-medium italic text-crimson-light">{copy.ctaAccent}</em></h2>
        <p class="mt-5 text-lg text-mist">{site.address.street}, {site.address.city} · {site.phone.display}</p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button href={lp(contactHref, lang)} variant="gold">{t.requestAppointment}</Button>
        <Button href={`tel:${site.phone.tel}`} variant="outline-light">{t.call} {site.phone.display}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
