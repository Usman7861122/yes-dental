---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedServices, serviceHrefFor } from "../data/services";
import { getServiceDetail } from "../data/serviceDetails";
import { getLang, lp } from "../i18n";
import { useUi } from "../i18n/ui";
import { site, fullAddress, contactHref } from "../data/site";
import Reveal from "../islands/Reveal";
import Icon from "../components/ui/Icon.astro";
import Button from "../components/ui/Button.astro";
import FaqList from "../components/ui/FaqList.astro";
import VisitBar from "../components/ui/VisitBar.astro";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const lang = getLang(Astro);
const t = useUi(lang);
const services = localizedServices(lang);
const service = services.find((s) => s.slug === slug)!;
const d = getServiceDetail(slug, lang);
const copy = {
  en: {
    metaTitle: `${service.title} in Manhattan | Yes Dental`,
    manhattan: "Manhattan",
    aboutEyebrow: "About this treatment",
    atYes: `${service.title} at Yes Dental`,
    kids: "Our pediatric specialists are affiliated with our group and operate out of 3 locations in NYC.",
    pleaseVisit: "Please visit",
    benefits: "Benefits",
    process: "The process",
    step: "Step",
    faqs: "FAQs",
    faqTitle: `Questions about ${service.title.toLowerCase()}`,
    general: "General information only. Your dentist will advise what is right for you after an examination.",
    ctaA: "Ready to book your",
    ctaAccent: service.title.toLowerCase(),
    ctaB: "visit?",
    others: "Explore our other services",
  },
  es: {
    metaTitle: `${service.title} en Manhattan | Yes Dental`,
    manhattan: "Manhattan",
    aboutEyebrow: "Sobre este tratamiento",
    atYes: `${service.title} en Yes Dental`,
    kids: "Nuestros especialistas pediátricos están afiliados a nuestro grupo y atienden en 3 ubicaciones en la ciudad de Nueva York.",
    pleaseVisit: "Visite",
    benefits: "Beneficios",
    process: "El proceso",
    step: "Paso",
    faqs: "Preguntas frecuentes",
    faqTitle: `Preguntas sobre ${service.title.toLowerCase()}`,
    general: "Información general solamente. Su dentista le indicará qué es lo mejor para usted después de un examen.",
    ctaA: "¿Listo para reservar su cita de",
    ctaAccent: service.title.toLowerCase(),
    ctaB: "?",
    others: "Conozca nuestros otros servicios",
  },
}[lang];
const imgs = [1, 2, 3].map((n) => `/images/services/gallery/${slug}-${n}.jpg`);
const others = services.filter((s) => s.slug !== slug);
const apptHref = `${lp(contactHref, lang)}?service=${encodeURIComponent(service.title)}`;
const isKids = slug === "pediatric-dentistry";

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: d.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<BaseLayout title={copy.metaTitle} description={d.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Hero + visit info -->
  <section class="on-dark relative isolate overflow-hidden bg-ink text-ivory">
    <div class="absolute -right-32 -top-32 -z-10 h-[30rem] w-[30rem] rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-x pb-14 pt-14 lg:pb-20 lg:pt-20">
      <nav aria-label={t.breadcrumb} class="text-sm text-mist">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={lp("/", lang)} class="inline-flex min-h-8 items-center hover:text-ivory">{t.home}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={lp("/services", lang)} class="inline-flex min-h-8 items-center hover:text-ivory">{t.services}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ivory">{service.title}</li>
        </ol>
      </nav>

      <p class="eyebrow mt-10 text-gold">{service.title} · {copy.manhattan}</p>
      <h1 class="h-hero mt-5 max-w-4xl !text-[clamp(2.8rem,6.5vw,5.5rem)]">
        {d.headline} <em class="font-medium italic text-crimson-light">{d.accent}</em>
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-mist sm:text-xl">{service.summary}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <Button href={apptHref} variant="gold">{t.requestAppointment} <Icon name="arrow-right" size={18} /></Button>
        <Button href={`tel:${site.phone.tel}`} variant="outline-light"><Icon name="phone" size={18} /> {site.phone.display}</Button>
      </div>

      <VisitBar class="mt-14" />
    </div>
  </section>

  <!-- Overview -->
  <section class="section-y bg-ivory">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <Reveal client:visible className="lg:col-span-6">
        <p class="eyebrow text-gold-deep">{copy.aboutEyebrow}</p>
        <h2 class="h-display mt-4">{copy.atYes}</h2>
        <span class="mt-7 block h-px w-16 bg-crimson"></span>
        <div class="mt-8 space-y-5 text-lg text-mute">
          {d.intro.map((p) => <p>{p}</p>)}
        </div>
        {
          isKids && (
            <p class="mt-8 rounded-2xl border border-line bg-sand p-6 text-ink">
              {copy.kids}
              <a href={site.kids.url} target="_blank" rel="noopener noreferrer" class="mt-2 flex min-h-11 items-center gap-2 font-semibold text-gold-deep underline underline-offset-4">
                {copy.pleaseVisit} {site.kids.name}<span class="sr-only"> {t.newTab}</span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            </p>
          )
        }
      </Reveal>
      <Reveal client:visible className="lg:col-span-6">
        <img src={imgs[0]} alt={d.imageAlts[0]} width="1200" height="800" loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-3xl object-cover shadow-[0_30px_70px_-35px_rgba(14,26,58,0.6)]" />
      </Reveal>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section-y bg-sand">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <Reveal client:visible className="order-2 lg:order-1 lg:col-span-5">
        <img src={imgs[1]} alt={d.imageAlts[1]} width="1200" height="800" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-3xl object-cover shadow-[0_30px_70px_-35px_rgba(14,26,58,0.6)] lg:aspect-[3/4]" />
      </Reveal>
      <div class="order-1 lg:order-2 lg:col-span-7">
        <Reveal client:visible>
          <p class="eyebrow text-gold-deep">{copy.benefits}</p>
          <h2 class="h-display mt-4">{d.benefitsTitle}</h2>
          <span class="mt-7 block h-px w-16 bg-crimson"></span>
        </Reveal>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2">
          {
            d.benefits.map((b, i) => (
              <li>
                <Reveal client:visible delay={i * 0.06} className="h-full">
                  <div class="h-full rounded-2xl bg-white p-7 shadow-[0_20px_50px_-35px_rgba(14,26,58,0.5)]">
                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-gold"><Icon name="check" size={20} /></span>
                    <h3 class="mt-5 text-2xl text-ink">{b.title}</h3>
                    <p class="mt-2 text-mute">{b.text}</p>
                  </div>
                </Reveal>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section-y bg-ivory">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal client:visible className="lg:sticky lg:top-28 lg:self-start">
          <p class="eyebrow text-gold-deep">{copy.process}</p>
          <h2 class="h-display mt-4">{d.stepsTitle}</h2>
          <span class="mt-7 block h-px w-16 bg-crimson"></span>
          <img src={imgs[2]} alt={d.imageAlts[2]} width="1200" height="800" loading="lazy" decoding="async" class="mt-10 aspect-[4/3] w-full rounded-3xl object-cover shadow-[0_30px_70px_-35px_rgba(14,26,58,0.6)]" />
        </Reveal>
      </div>
      <ol class="space-y-5 lg:col-span-7">
        {
          d.steps.map((s, i) => (
            <li>
              <Reveal client:visible delay={0.05}>
                <div class="flex gap-6 rounded-2xl border border-line bg-white p-7">
                  <span class="font-display text-5xl leading-none text-gold-deep" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <div>
                    <h3 class="text-2xl text-ink"><span class="sr-only">{copy.step} {i + 1}: </span>{s.title}</h3>
                    <p class="mt-2 text-mute">{s.text}</p>
                  </div>
                </div>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ (open by default) -->
  <section class="section-y bg-sand" aria-labelledby="faq-title">
    <div class="container-x max-w-4xl">
      <div class="text-center">
        <p class="eyebrow text-gold-deep">{copy.faqs}</p>
        <h2 id="faq-title" class="h-display mt-4">{copy.faqTitle}</h2>
        <span class="mx-auto mt-7 block h-px w-16 bg-crimson"></span>
      </div>
      <div class="mt-12">
        <FaqList items={d.faqs} open />
      </div>
      <p class="mt-8 text-center text-sm text-mute">{copy.general}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="on-dark relative isolate overflow-hidden bg-ink py-20 text-ivory lg:py-24">
    <div class="absolute -left-32 bottom-0 -z-10 h-[26rem] w-[26rem] rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-x flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div>
        <h2 class="h-display max-w-2xl">{copy.ctaA} <em class="font-medium italic text-crimson-light">{copy.ctaAccent}</em>{copy.ctaB === "?" ? "?" : ` ${copy.ctaB}`}</h2>
        <p class="mt-5 text-lg text-mist">{fullAddress} · {site.phone.display}</p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button href={apptHref} variant="gold">{t.requestAppointment}</Button>
        <Button href={`tel:${site.phone.tel}`} variant="outline-light">{t.call} {site.phone.display}</Button>
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="section-y bg-ivory">
    <div class="container-x">
      <h2 class="eyebrow text-center text-gold-deep">{copy.others}</h2>
      <ul class="mx-auto mt-8 flex max-w-4xl flex-wrap justify-center gap-3">
        {
          others.map((s) => (
            <li>
              <a href={serviceHrefFor(s, lang)} class="inline-flex min-h-11 items-center rounded-full border border-ink/20 bg-white px-5 text-[0.9rem] font-semibold text-ink transition duration-300 hover:border-gold-deep hover:bg-sand">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 text-center"><Button href={lp("/services", lang)} variant="outline">{t.viewAllServices}</Button></div>
    </div>
  </section>
</BaseLayout>
