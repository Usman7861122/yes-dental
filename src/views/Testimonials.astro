---
import BaseLayout from "../layouts/BaseLayout.astro";
import { testimonials } from "../data/testimonials";
import { contactHref, site } from "../data/site";
import { getLang, lp, formatDate } from "../i18n";
import { useUi } from "../i18n/ui";
import PageHero from "../components/ui/PageHero.astro";
import Reveal from "../islands/Reveal";
import Button from "../components/ui/Button.astro";

const lang = getLang(Astro);
const ui = useUi(lang);
const copy = {
  en: {
    title: "Patient Testimonials | Yes Dental",
    description: "Read what patients say about their visits to Yes Dental in Manhattan.",
    eyebrow: "Testimonials",
    h1: "Loved by our",
    accent: "patients.",
    intro: "Kind words from the people we care for. Thank you for trusting us with your smile.",
    stars: "5 out of 5 stars",
    ctaA: "Ready to join our",
    ctaAccent: "happy patients?",
    ctaText: `Call ${site.phone.display} or request an appointment online.`,
  },
  es: {
    title: "Testimonios de pacientes | Yes Dental",
    description: "Lea lo que dicen los pacientes sobre sus visitas a Yes Dental, en Manhattan.",
    eyebrow: "Testimonios",
    h1: "Queridos por nuestros",
    accent: "pacientes.",
    intro: "Palabras amables de las personas que cuidamos. Gracias por confiarnos su sonrisa.",
    stars: "5 de 5 estrellas",
    ctaA: "¿Listo para unirse a nuestros",
    ctaAccent: "pacientes felices?",
    ctaText: `Llame al ${site.phone.display} o solicite una cita en línea.`,
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.h1}
    accent={copy.accent}
    intro={copy.intro}
  />

  <section class="section-y bg-sand">
    <div class="container-x">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          testimonials.map((t, i) => (
            <li>
              <Reveal client:visible delay={(i % 3) * 0.07} className="h-full">
                <figure class="flex h-full flex-col rounded-2xl bg-white p-8 shadow-[0_20px_50px_-35px_rgba(14,26,58,0.5)]">
                  <div class="flex gap-1 text-gold-deep" role="img" aria-label={copy.stars}>
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                    ))}
                  </div>
                  <blockquote lang={t.lang} class="mt-5 flex-1 font-display text-2xl leading-snug text-ink">“{t.quote}”</blockquote>
                  <figcaption class="mt-6 border-t border-line pt-5 text-[0.95rem] font-semibold text-ink">
                    {t.name}
                    {t.date && <span class="font-normal text-mute"> · {formatDate(t.date, lang)}</span>}
                  </figcaption>
                </figure>
              </Reveal>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="on-dark bg-ink py-20 text-ivory lg:py-24">
    <div class="container-x flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div>
        <h2 class="h-display max-w-2xl">{copy.ctaA} <em class="font-medium italic text-crimson-light">{copy.ctaAccent}</em></h2>
        <p class="mt-5 text-lg text-mist">{copy.ctaText}</p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button href={lp(contactHref, lang)} variant="gold">{ui.requestAppointment}</Button>
        <Button href={`tel:${site.phone.tel}`} variant="outline-light">{ui.call} {site.phone.display}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
