---
interface Props {
  items: { q: string; a: string }[];
  open?: boolean; // all open by default
}
const { items, open = true } = Astro.props;
---

<div class="divide-y divide-line rounded-2xl border border-line bg-white">
  {
    items.map((f) => (
      <details class="group" open={open}>
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 px-6 py-4 text-left font-display text-2xl leading-snug text-ink transition-colors hover:text-gold-deep sm:px-8 [&::-webkit-details-marker]:hidden">
          {f.q}
          <span aria-hidden="true" class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/20 text-ink transition-colors group-open:border-crimson group-open:text-crimson">
            <span class="absolute h-px w-3.5 bg-current"></span>
            <span class="absolute h-3.5 w-px bg-current transition-transform duration-300 group-open:scale-y-0"></span>
          </span>
        </summary>
        <p class="px-6 pb-6 pr-16 text-mute sm:px-8 sm:pr-20">{f.a}</p>
      </details>
    ))
  }
</div>
