---
interface Props {
  name: string;
  class?: string;
  size?: number;
  stroke?: number;
}
import { icons } from "../../lib/icons";
const { name, class: cls = "", size = 24, stroke = 1.5 } = Astro.props;

---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
>
  {(icons[name] ?? []).map((d) => <path d={d} />)}
</svg>
