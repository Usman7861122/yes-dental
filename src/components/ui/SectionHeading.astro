---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  dark?: boolean;
}
const { eyebrow, title, intro, align = "left", dark = false } = Astro.props;
---

<div class={align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  <p class:list={["eyebrow", dark ? "text-gold" : "text-gold-deep"]}>{eyebrow}</p>
  <h2 class:list={["h-display mt-4", dark ? "text-ivory" : "text-ink"]}>{title}</h2>
  {intro && <p class:list={["mt-5 text-lg", dark ? "text-mist" : "text-mute"]}>{intro}</p>}
  <span class:list={["mt-7 block h-px w-16", dark ? "bg-crimson-light" : "bg-crimson", align === "center" && "mx-auto"]}></span>
</div>
