---
import { testimonials } from "../../data/testimonials";
import SectionHeading from "../ui/SectionHeading.astro";
import TestimonialSlider from "../../islands/TestimonialSlider";
import Button from "../ui/Button.astro";
import { getLang, lp } from "../../i18n";

const lang = getLang(Astro);
const copy = {
  en: { eyebrow: "Patient stories", title: "Loved by our patients.", cta: "Read All Reviews" },
  es: { eyebrow: "Historias de pacientes", title: "Queridos por nuestros pacientes.", cta: "Leer todas las reseñas" },
}[lang];
---

<section id="testimonials" class="section-y bg-sand">
  <div class="container-x">
    <SectionHeading eyebrow={copy.eyebrow} title={copy.title} align="center" />
    <div class="mt-14">
      <TestimonialSlider client:visible items={testimonials} lang={lang} />
    </div>
    <div class="mt-12 text-center"><Button href={lp("/testimonials", lang)} variant="outline">{copy.cta}</Button></div>
  </div>
</section>
