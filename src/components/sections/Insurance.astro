---
import { carriers, alsoAccepted } from "../../data/insurance";
import Reveal from "../../islands/Reveal";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
const { page = false } = Astro.props;

const steps = [
  { title: "Share your plan", text: "Tell us your insurance when you book. No plan? Ask about our discount membership." },
  { title: "We check your benefits", text: "Our team confirms what your plan covers, so there are no surprises." },
  { title: "Know your cost first", text: "You receive a clear estimate and explanation before any treatment begins." },
];

const faqs = [
  { q: "Do you accept my insurance?", a: "We accept most major plans, listed above. Call us and we will confirm your benefits." },
  { q: "Do you accept Medicare or Medicaid?", a: "Yes. We also accept union plans. Please call us to confirm details." },
  { q: "What if I do not have insurance?", a: "Our discount membership gives you 50%+ off our regular fees for an annual subscription." },
  { q: "Can I spread the cost of treatment?", a: "Ask our team about flexible payment options. We will explain what is available before you decide." },
];
---

<section id="insurance" class="section-y bg-ivory">
  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-20">
    <!-- LEFT: stays in place until the right column has finished scrolling -->
    <Reveal client:visible className="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
      <SectionHeading
        eyebrow={page ? "Plans & payment" : "Insurance & financing"}
        title={page ? "Care that fits your budget." : "Insurance and Financing Options"}
        intro="We work with most major plans and offer flexible ways to pay, so great dental care fits your budget."
      />
      <div class="mt-10 rounded-2xl bg-sand p-8">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-gold/25 text-gold-deep">
          <Icon name="shield-check" size={24} />
        </span>
        <h3 class="mt-5 text-3xl">Flexible payment options</h3>
        <p class="mt-3 text-mute">
          Not sure what your plan covers? Our team will check your benefits and explain every cost before treatment begins.
        </p>
        <div class="mt-6">
          <Button href="/contact-us" variant="ink">Ask About Financing</Button>
        </div>
      </div>
    </Reveal>

    <!-- RIGHT: scrolls with the page -->
    <div class="lg:col-span-7">
      <Reveal client:visible delay={0.1}>
        <h3 class="eyebrow text-gold-deep">Plans we accept</h3>
        <ul class="mt-6 flex flex-wrap gap-3">
          {
            carriers.map((c) => (
              <li class="rounded-full border border-line bg-white px-6 py-3 font-semibold text-ink transition-colors duration-300 hover:border-gold hover:bg-sand">
                {c}
              </li>
            ))
          }
        </ul>
        <h3 class="eyebrow mt-10 text-gold-deep">Also accepted</h3>
        <ul class="mt-6 flex flex-wrap gap-3">
          {alsoAccepted.map((c) => <li class="rounded-full bg-ink px-6 py-3 font-semibold text-ivory">{c}</li>)}
        </ul>
        <p class="mt-8 text-sm text-mute">Coverage varies by plan. Please call us to confirm your benefits.</p>
      </Reveal>

      <Reveal client:visible className="mt-20">
        <h3 class="eyebrow text-gold-deep">How it works</h3>
        <ol class="mt-6 space-y-5">
          {
            steps.map((s, i) => (
              <li class="flex gap-6 rounded-2xl border border-line bg-white p-6 sm:p-8">
                <span class="font-display text-5xl leading-none text-gold">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h4 class="font-display text-3xl">{s.title}</h4>
                  <p class="mt-2 text-mute">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </Reveal>

      <Reveal client:visible className="mt-20">
        <h3 class="eyebrow text-gold-deep">Common questions</h3>
        <div class="mt-6 divide-y divide-line border-y border-line">
          {
            faqs.map((f) => (
              <details class="group py-2">
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 font-display text-2xl text-ink [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-gold-deep transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </summary>
                <p class="pb-5 pr-12 text-mute">{f.a}</p>
              </details>
            ))
          }
        </div>
      </Reveal>
    </div>
  </div>
</section>
