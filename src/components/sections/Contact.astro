---
import { site, mapsUrl, contactHref } from "../../data/site";
import Reveal from "../../islands/Reveal";
import Icon from "../ui/Icon.astro";
import { getLang, lp } from "../../i18n";
import { useUi } from "../../i18n/ui";

const lang = getLang(Astro);
const t = useUi(lang);
const copy = {
  en: {
    eyebrow: "Contact",
    title: "Begin your smile journey.",
    text: "Tell us how we can help and our team will get back to you shortly. Prefer to talk? We would love to hear from you.",
    card: "Request an appointment",
    ready: "Ready when you are.",
    cardText: "Tell us your name, phone number and the service you need. We will call you to find a time that suits you.",
    list: ["Quick form, takes about a minute", "We check your insurance if you ask", "Clear costs explained before treatment"],
    cta: "Request Appointment",
  },
  es: {
    eyebrow: "Contacto",
    title: "Comience el camino hacia su sonrisa.",
    text: "Cuéntenos cómo podemos ayudarle y nuestro equipo se comunicará pronto con usted. ¿Prefiere hablar? Nos encantará escucharle.",
    card: "Solicite una cita",
    ready: "Listos cuando usted lo esté.",
    cardText: "Díganos su nombre, su teléfono y el servicio que necesita. Lo llamaremos para encontrar un horario que le convenga.",
    list: ["Formulario rápido, toma cerca de un minuto", "Revisamos su seguro si lo pide", "Costos claros explicados antes del tratamiento"],
    cta: "Solicitar cita",
  },
}[lang];

const item = "group flex items-center gap-4";
const bubble =
  "flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-gold/50 text-gold transition-colors duration-300 group-hover:bg-gold group-hover:text-ink";
---

<section id="contact" class="on-dark relative isolate overflow-hidden bg-ink section-y text-ivory">
  <div class="absolute -left-40 top-0 -z-10 h-[34rem] w-[34rem] rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>

  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <Reveal client:visible>
        <p class="eyebrow text-gold">{copy.eyebrow}</p>
        <h2 class="h-display mt-4">{copy.title}</h2>
        <span class="mt-7 block h-px w-16 bg-crimson-light"></span>
        <p class="mt-8 text-lg text-mist">
          {copy.text}
        </p>

        <ul class="mt-10 space-y-7">
          <li>
            <a href={`tel:${site.phone.tel}`} class={item}>
              <span class={bubble}><Icon name="phone" size={22} /></span>
              <span>
                <span class="block text-sm text-mist">{t.callUs}</span>
                <span class="font-display text-3xl text-ivory">{site.phone.display}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class={item}>
              <span class={bubble}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              </span>
              <span>
                <span class="block text-sm text-mist">{t.emailUs}</span>
                <span class="font-display text-3xl text-ivory break-all">{site.email}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class={item}>
              <span class={bubble}><Icon name="map-pin" size={22} /></span>
              <span>
                <span class="block text-sm text-mist">{t.visitUs}</span>
                <span class="font-display text-2xl leading-tight text-ivory sm:text-3xl">
                  {site.address.street}<br />{site.address.city}
                </span>
                <span class="sr-only"> {t.newTab}</span>
              </span>
            </a>
          </li>
        </ul>
      </Reveal>
    </div>

    <div class="lg:col-span-7">
      <Reveal client:visible delay={0.1}>
        <div class="rounded-3xl bg-ivory p-8 text-ink shadow-[0_30px_80px_-30px_rgba(0,0,0,0.6)] sm:p-12">
          <p class="eyebrow text-gold-deep">{copy.card}</p>
          <h3 class="mt-4 text-4xl sm:text-5xl">{copy.ready}</h3>
          <p class="mt-4 max-w-md text-mute">
            {copy.cardText}
          </p>
          <ul class="mt-8 space-y-3">
            {
              copy.list.map((txt) => (
                <li class="flex items-center gap-3 text-ink">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold/25 text-gold-deep"><Icon name="check" size={16} stroke={2.2} /></span>
                  {txt}
                </li>
              ))
            }
          </ul>
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a href={lp(contactHref, lang)} class="btn btn-ink">{copy.cta} <Icon name="arrow-right" size={18} /></a>
            <a href={`tel:${site.phone.tel}`} class="btn btn-outline">{t.call} {site.phone.display}</a>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
