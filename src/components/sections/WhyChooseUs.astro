---
import { whyStepsFor } from "../../data/why";
import { getLang } from "../../i18n";
import { useUi } from "../../i18n/ui";
import { icons } from "../../lib/icons";
import Reveal from "../../islands/Reveal";
import WhyTimeline from "../../islands/WhyTimeline";

const lang = getLang(Astro);
const t = useUi(lang);
const copy = {
  en: { eyebrow: "Why choose us", a: "Your path to a", accent: "healthy smile.", intro: "What a visit with us looks like, from your first call to your last follow-up." },
  es: { eyebrow: "Por qué elegirnos", a: "Su camino hacia una", accent: "sonrisa sana.", intro: "Cómo es una visita con nosotros, desde su primera llamada hasta su último seguimiento." },
}[lang];
---

<section id="why" class="on-dark relative isolate overflow-hidden bg-ink section-y text-ivory">
  <!-- faint tooth watermark -->
  <svg viewBox="0 0 24 24" aria-hidden="true" class="pointer-events-none absolute -left-24 top-24 -z-10 h-[34rem] w-[34rem] text-white/[0.03]" fill="currentColor">
    <path d={icons.tooth[0]}></path>
  </svg>

  <div class="container-x">
    <Reveal client:visible>
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow text-gold">{copy.eyebrow}</p>
        <h2 class="h-display mt-5 text-ivory">
          {copy.a} <em class="font-medium italic text-crimson-light">{copy.accent}</em>
        </h2>
        <p class="mt-6 text-lg text-mist">{copy.intro}</p>
      </div>
    </Reveal>

    <WhyTimeline client:visible steps={whyStepsFor(lang)} stepLabel={t.step} />
  </div>
</section>
