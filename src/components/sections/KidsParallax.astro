---
import { site } from "../../data/site";
import Reveal from "../../islands/Reveal";
import Icon from "../ui/Icon.astro";
import { getLang } from "../../i18n";
import { useUi } from "../../i18n/ui";

const lang = getLang(Astro);
const t = useUi(lang);
const copy = {
  en: { eyebrow: "Our family of care", title: "Pediatric specialists affiliated with our group", big: "KIDS DENTAL", sub: "operating out of 3 locations in NYC", visit: "Please visit" },
  es: { eyebrow: "Nuestra familia de cuidado", title: "Especialistas pediátricos afiliados a nuestro grupo", big: "DENTISTA PARA NIÑOS", sub: "con 3 ubicaciones en la ciudad de Nueva York", visit: "Visite" },
}[lang];
---

<section
  aria-labelledby="kids-title"
  class="on-dark parallax-fixed relative isolate flex min-h-[100svh] items-center bg-ink py-24 text-center text-ivory"
  style="background-image: url('/images/kids-parallax.jpg')"
>
  <div class="absolute inset-0 -z-10 bg-ink/70"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/50 via-transparent to-ink/60"></div>

  <div class="container-x">
    <Reveal client:visible>
      <p class="eyebrow text-gold">{copy.eyebrow}</p>
      <h2 id="kids-title" class="h-display mx-auto mt-5 max-w-3xl">
        {copy.title}
      </h2>
      <p class="mt-10 font-display text-6xl font-semibold tracking-[0.08em] text-gold sm:text-8xl lg:text-9xl">
        {copy.big}
      </p>
      <p class="mt-4 text-xl text-ivory sm:text-2xl">{copy.sub}</p>
      <p class="mx-auto mt-8 max-w-md text-mist">{copy.visit}</p>
      <div class="mt-4">
        <a href={site.kids.url} target="_blank" rel="noopener noreferrer" class="btn btn-gold">
          {site.kids.name}
          <Icon name="arrow-up-right" size={18} />
          <span class="sr-only">{t.newTab}</span>
        </a>
      </div>
    </Reveal>
  </div>
</section>
