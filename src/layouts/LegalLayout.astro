---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={`${title} | Yes Dental`} description={description}>
  <section class="on-dark bg-ink pb-16 pt-16 text-ivory lg:pb-20 lg:pt-24">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-mist">
        <a href="/" class="inline-flex min-h-8 items-center hover:text-ivory">Home</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span aria-current="page" class="text-ivory">{title}</span>
      </nav>
      <h1 class="h-display mt-8 max-w-3xl">{title}</h1>
      <p class="mt-5 text-mist">Last updated: {updated}</p>
    </div>
  </section>
  <section class="section-y bg-ivory !pt-14 lg:!pt-20">
    <div class="container-x">
      <div class="legal mx-auto max-w-3xl text-lg leading-relaxed">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
