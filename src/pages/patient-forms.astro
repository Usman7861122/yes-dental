---
import BaseLayout from "../layouts/BaseLayout.astro";
import { forms } from "../data/forms";
import { site, contactHref } from "../data/site";
import PageHero from "../components/ui/PageHero.astro";
import Reveal from "../islands/Reveal";
import Icon from "../components/ui/Icon.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Patient Forms | Yes Dental" description="Download the Yes Dental patient registration form in English or Spanish and fill it in before your visit.">
  <PageHero
    eyebrow="Patient Forms"
    title="Save time at your"
    accent="first visit."
    intro="Download our registration form, fill it in at home, and bring it with you to your appointment."
  />

  <section class="section-y bg-sand">
    <div class="container-x">
      <ul class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {
          forms.map((f, i) => (
            <li>
              <Reveal client:visible delay={i * 0.08} className="h-full">
                <article class="flex h-full flex-col rounded-2xl bg-white p-8 shadow-[0_20px_50px_-35px_rgba(14,26,58,0.5)] sm:p-10" lang={f.lang}>
                  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink text-gold">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                  </span>
                  <p class="eyebrow mt-6 text-gold-deep">{f.language}</p>
                  <h2 class="mt-2 text-4xl text-ink">{f.title}</h2>
                  <p class="mt-4 flex-1 text-mute">{f.description}</p>
                  <p class="mt-6 text-sm text-mute">{f.format} · {f.size}</p>
                  <a
                    href={f.href}
                    download
                    class="btn btn-ink mt-6 w-full sm:w-auto sm:self-start"
                    aria-label={`${f.title}, ${f.format}, ${f.size}`}
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg>
                    {f.lang === "es" ? "Descargar formulario" : "Download Form"}
                  </a>
                </article>
              </Reveal>
            </li>
          ))
        }
      </ul>
      <p class="mx-auto mt-10 max-w-2xl text-center text-mute">
        Need help with a form or want it in another format? Call us on <a href={`tel:${site.phone.tel}`} class="font-semibold text-gold-deep underline underline-offset-4">{site.phone.display}</a> and our team will be happy to help.
      </p>
    </div>
  </section>

  <section class="on-dark bg-ink py-20 text-ivory lg:py-24">
    <div class="container-x flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div>
        <h2 class="h-display max-w-2xl">Ready to <em class="font-medium italic text-crimson-light">book your visit?</em></h2>
        <p class="mt-5 text-lg text-mist">{site.address.street}, {site.address.city} · {site.phone.display}</p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button href={contactHref} variant="gold">Request Appointment</Button>
        <Button href={`tel:${site.phone.tel}`} variant="outline-light">Call {site.phone.display}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
